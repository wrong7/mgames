{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mgames-realtime",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"observability": { "enabled": true },

	// Cada sala es un Durable Object: un objeto con su propio hilo y su propia
	// memoria, que es exactamente la unidad de aislamiento que queremos aquí.
	"durable_objects": {
		"bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
	},
	"migrations": [
		{
			"tag": "v1",
			// Los Durable Objects con almacenamiento SQLite son los únicos disponibles
			// en el plan gratuito, y son también los que admiten hibernación.
			"new_sqlite_classes": ["GameRoom"]
		}
	],

	"vars": {
		// Orígenes que pueden abrir salas, separados por comas y sin barra final
		// (es lo que manda el navegador). En blanco = cualquiera: es lo que usa
		// `pnpm dev`, que la vacía con `--var` para poder jugar desde localhost.
		"ALLOWED_ORIGINS": "https://malitos.vercel.app"
	}
}
